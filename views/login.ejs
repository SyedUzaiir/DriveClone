<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.css" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body
    class="bg-gray-100 dark:bg-gray-800"
>
<div class="min-h-screen flex items-center justify-center bg-gray-100">
  
  <form action="/user/login" method="post" class="bg-white shadow-xl rounded-xl p-8 w-full max-w-md">

    <h2 class="text-2xl font-semibold text-center mb-6">
      Login Account
    </h2>

    <!-- Name -->
    <div class="mb-4 w-full block">
      <label class="block mb-1 text-sm font-medium">User Name</label>
      <input 
        type="text"
        placeholder="John Doe"
        class="block w-full px-4 py-2 border rounded-lg"
        name="username"
      />
    </div>

    <!-- Password -->
    <div class="mb-6 w-full block">
      <label class="block mb-1 text-sm font-medium">Password</label>
      <input 
        type="password"
        placeholder="••••••••"
        class="block w-full px-4 py-2 border rounded-lg"
        name="password"
      />
    </div>

    <!-- Button -->
    <button class="w-full bg-blue-600 text-white py-2.5 rounded-lg">
      Submit
    </button>

  </form>

</div>



  <script src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"></script>
</body>
</html>